# COOKIE_SECURE:
#   1 للإنتاج — 0 للتطوير المحلي
COOKIE_SECURE=1

# Internet Archive (S3) — مجاني، روابط دائمة (موصى به)
# ARCHIVE_ACCESS_KEY_ID=
# ARCHIVE_SECRET_ACCESS_KEY=
# ARCHIVE_PUBLIC_BASE=https://archive.org/download

# Backblaze B2 (أو Cloudflare R2) — بدائل
# يُفضَّل B2؛ يُستخدم R2 إن وُجدت متغيراته ولم تُوجد متغيرات B2.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_REGION=us-west-004
# B2_PUBLIC_BASE=https://<bucket>.s3.<region>.backblazeb2.com

# R2 (بديل)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE=https://<bucket>.<account>.r2.dev

# الرابط العام المستخدم في rewrite بـ Vercel (اختياري — يُستنتج من B2/R2)
# LESSONS_PUBLIC_BASE=https://<bucket>.s3.<region>.backblazeb2.com
